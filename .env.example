# Copy to .env for local overrides; never commit .env. Production values are set in the
# Render and Vercel dashboards, not in files. Wreckyard's own settings all use the
# WRECKYARD_ prefix; only the standard PORT and NODE_ENV are unprefixed.

# --- Client (Vite, baked in at build time; set per environment in Vercel) ---------------
# Game server address. ws(s):// or http(s):// both work; "/ws" is added if no path is given.
# Unset in `npm run dev`: uses the dev proxy. Unset in a production build: online play is off.
VITE_WRECKYARD_SERVER_URL=

# --- Vite dev proxy (local development only) ---------------------------------------------
WRECKYARD_SERVER_PORT=8787

# --- Server (read from the process environment; Render sets PORT itself) -----------------
# The server does not read .env: export these in your shell or use docker compose.
PORT=8787
# Browser origins allowed to open a socket. Required when NODE_ENV=production.
# Exact origins, "https://*.example.app" for one subdomain level, or "*" for any.
WRECKYARD_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
WRECKYARD_MAX_ROOMS=50
# Snapshot broadcasts per second (1-60). Clients buffer about two intervals.
WRECKYARD_SNAPSHOT_HZ=20
# Per-socket message rate limit; at least 70 (60 inputs plus pings each second).
WRECKYARD_MAX_MSG_PER_SEC=120
WRECKYARD_LOG_LEVEL=info
WRECKYARD_SHUTDOWN_GRACE_MS=5000
# Simulated one-way latency for testing netcode locally. Refused in production.
WRECKYARD_LAG_MS=0
WRECKYARD_JITTER_MS=0
